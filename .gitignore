# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.pyright/
.coverage
htmlcov/

# Run outputs. PLAN.md §5: configs reach the server via git, results must not come back.
runs/
wandb/
logs/

# Weights — never committed, not in the fixture and not anywhere else
*.pt
*.pth
*.onnx
*.engine

# Vendored third-party checkpoints. The vendored *source* is tracked (PLAN.md §7).
third_party/**/checkpoints/

# Datasets — never tracked, no exceptions, not even the 9-pair smoke fixture.
# This remote is PUBLIC and the thermal/visible pairs are unpublished research data.
# Consequence: tests must not depend on committed images. Build synthetic pairs with
# `tmp_path_factory`, and skip any test wanting the real fixture when it is absent.
dataset/

# ultralytics-generated label caches — derived state; stale ones fail silently
*.cache

# OS / editor / agent
.DS_Store
.idea/
.vscode/
.claude/
